{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure stage2 Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build-mpich-debug",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_CXX_COMPILER=/home/votrongnam/opt/mpich-4.0-ch3-cxx/bin/mpicxx",
        "-DPETSC_PKG=PETSc"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib/pkgconfig"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    //------------------------------------------------------------------
    {
      "label": "CMake: build stage2 Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-mpich-debug",
        "--target",
        "stage2_dynamic_forward",
        "-j"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib/pkgconfig"
        }
      },
      "dependsOn": "CMake: configure stage2 Debug",
      "problemMatcher": "$gcc"
    },
    //------------------------------------------------------------------
    {
      "label": "CMake: configure stage2 Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build-mpich-release",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_CXX_COMPILER=/home/votrongnam/opt/mpich-4.0-ch3-cxx/bin/mpicxx",
        "-DPETSC_PKG=PETSc"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib/pkgconfig"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    //------------------------------------------------------------------
    {
      "label": "CMake: build stage2 Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-mpich-release",
        "--target",
        "stage2_dynamic_forward",
        "-j"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib/pkgconfig"
        }
      },
      "dependsOn": "CMake: configure stage2 Release",
      "problemMatcher": "$gcc"
    },
    //------------------------------------------------------------------
    {
      "label": "Run: multi_node multi_rank",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release",
          "CASE_CONFIG": "case_study/test1/600x200_sin_1cycle_125Hz.conf",
          "NP": "2",
          "HOSTS": "localhost,192.168.11.21",
          "KSP_TYPE": "cg",
          "PC_TYPE": "gamg",
          "PC_FACTOR_MAT_SOLVER_TYPE": "",
          "OMP_NUM_THREADS": "1",
          "MKL_NUM_THREADS": "1",
          "OMP_PROC_BIND": "spread",
          "OMP_PLACES": "cores"
        }
      },
      "dependsOn": "CMake: build stage2 Release",
      "group": "test",
      "problemMatcher": []
    },
    //------------------------------------------------------------------
    {
      "label": "Run: single node multi_rank",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release",
          "CASE_CONFIG": "case_study/test1/600x200_sin_1cycle_125Hz.conf",
          "NP": "8",
          "HOSTS": "localhost",
          "KSP_TYPE": "cg",
          "PC_TYPE": "gamg",
          "PC_FACTOR_MAT_SOLVER_TYPE": "",
          "OMP_NUM_THREADS": "1",
          "MKL_NUM_THREADS": "1",
          "OMP_PROC_BIND": "spread",
          "OMP_PLACES": "cores"
        }
      },
      "dependsOn": "CMake: build stage2 Release",
      "group": "test",
      "problemMatcher": []
    },
    //------------------------------------------------------------------
    {
      "label": "Run: single node single rank",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release",
          "CASE_CONFIG": "case_study/test1/600x200_sin_1cycle_125Hz.conf",
          "NP": "1",
          "HOSTS": "localhost",
          "KSP_TYPE": "preonly",
          "PC_TYPE": "lu",
          "PC_FACTOR_MAT_SOLVER_TYPE": "mkl_pardiso",
