    // ------------------ configure stage2 Debug--------------------------------------------------
    {
      "label": "CMake: configure stage2 Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build-mpich-debug-gcc13",
        // GCC11 option:
        // "${workspaceFolder}/build-mpich-debug-gcc11",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_CXX_COMPILER=/home/votrongnam/opt/mpich-4.0-ch3-cxx-gcc13/bin/mpicxx",
        // GCC11 option:
        // "-DCMAKE_CXX_COMPILER=/home/votrongnam/opt/mpich-4.0-ch3-cxx-gcc11/bin/mpicxx",
        "-DSTAGE2_EIGEN_USE_LAPACKE=ON",
        // Eigen backend only: ON -> Eigen::PardisoLDLT, OFF -> Eigen::SimplicialLDLT
        // "-DSTAGE2_EIGEN_USE_LAPACKE=OFF",
        "-DPETSC_PKG=PETSc"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps-gcc13/lib/pkgconfig"
          // GCC11 option:
          // "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps-gcc11/lib/pkgconfig"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    //---------------------build stage2 Debug---------------------------------------------
    {
      "label": "CMake: build stage2 Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-mpich-debug-gcc13",
        // GCC11 option:
        // "${workspaceFolder}/build-mpich-debug-gcc11",
        "--target",
        "stage2_dynamic_forward",
        "-j"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: configure stage2 Debug",
      "problemMatcher": "$gcc"
    },
    //--------------------- configure stage2 Release---------------------------------------------
