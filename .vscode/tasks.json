{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure stage2 Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build-mpich-debug",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_CXX_COMPILER=/home/votrongnam/opt/mpich-4.0-ch3-cxx/bin/mpicxx",
        "-DPETSC_PKG=PETSc"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib/pkgconfig"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    //------------------------------------------------------------------
    {
      "label": "CMake: build stage2 Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-mpich-debug",
        "--target",
        "stage2_dynamic_forward",
        "-j"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib/pkgconfig"
        }
      },
      "dependsOn": "CMake: configure stage2 Debug",
      "problemMatcher": "$gcc"
    },
    //------------------------------------------------------------------
    {
      "label": "CMake: configure stage2 Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build-mpich-release",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_CXX_COMPILER=/home/votrongnam/opt/mpich-4.0-ch3-cxx/bin/mpicxx",
        "-DPETSC_PKG=PETSc"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib/pkgconfig"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    //------------------------------------------------------------------
    {
      "label": "CMake: build stage2 Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-mpich-release",
        "--target",
        "stage2_dynamic_forward",
        "-j"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PKG_CONFIG_PATH": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib/pkgconfig"
        }
      },
      "dependsOn": "CMake: configure stage2 Release",
      "problemMatcher": "$gcc"
    },
    //------------------multi_node multi_rank, MPI------------------------------------------------
    {
      "label": "Run: multi_node multi_rank",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release",
          "CASE_CONFIG": "case_study/test1/600x200_sin_1cycle_125Hz.conf",
          "METHOD_NAME": "MyStrategy", // MyStrategy: IncrementalSVD; MyStrategy2: MyIncrementalQR1 QR online basis
          "NP": "8",
          "HOSTS": "localhost,192.168.11.21",
          "KSP_TYPE": "cg", // cg: iterative SPD; preonly: use direct factorization once per set_factorization
          "PC_TYPE": "gamg", // gamg: iterative AMG; lu/cholesky: direct; cholesky only for SPD matrices
          "PC_FACTOR_MAT_SOLVER_TYPE": "", // empty for iterative; direct options: mkl_pardiso(single-node), mumps(MPI/multinode)
          "POD_BACKEND": "snapshot_mkl", // snapshot_mkl: MKL POD; snapshot_eigen: Eigen POD; bdcsvd: old Eigen BDCSVD
          "ONLINE_BACKEND": "incremental_mkl", // incremental_mkl: MKL IncrementalSVD; incremental_eigen: Eigen IncrementalSVD
          "OMP_NUM_THREADS": "1", // MPI-heavy runs usually use 1; single-rank direct can use 4,8,16
          "MKL_NUM_THREADS": "1", // match OMP_NUM_THREADS for MKL/Pardiso; use 1 for many MPI ranks
          "OMP_PROC_BIND": "spread", // spread or close
          "OMP_PLACES": "cores" // cores or threads
        }
      },
      "dependsOn": "CMake: build stage2 Release",
      "group": "test",
      "problemMatcher": []
    },
    //-----------single node multi_rank, MPI, very slow-------------------------------------------------------
    {
      "label": "Run: single node multi_rank MPI",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release",
          "CASE_CONFIG": "case_study/test1/600x200_sin_1cycle_125Hz.conf",
          "METHOD_NAME": "MyStrategy", // MyStrategy: IncrementalSVD; MyStrategy2: MyIncrementalQR1 QR online basis
          "NP": "8",
          "HOSTS": "localhost",
          "KSP_TYPE": "cg", // cg: iterative SPD; preonly: use direct factorization once per set_factorization
          "PC_TYPE": "gamg", // gamg: iterative AMG; lu/cholesky: direct; cholesky only for SPD matrices
          "PC_FACTOR_MAT_SOLVER_TYPE": "", // empty for iterative; direct options: mkl_pardiso(single-node), mumps(MPI/multinode)
          "POD_BACKEND": "snapshot_mkl", // snapshot_mkl: MKL POD; snapshot_eigen: Eigen POD; bdcsvd: old Eigen BDCSVD
          "ONLINE_BACKEND": "incremental_mkl", // incremental_mkl: MKL IncrementalSVD; incremental_eigen: Eigen IncrementalSVD
          "OMP_NUM_THREADS": "1", // MPI-heavy runs usually use 1; single-rank direct can use 4,8,16
          "MKL_NUM_THREADS": "1", // match OMP_NUM_THREADS for MKL/Pardiso; use 1 for many MPI ranks
          "OMP_PROC_BIND": "spread", // spread or close
          "OMP_PLACES": "cores" // cores or threads
        }
      },
      "dependsOn": "CMake: build stage2 Release",
      "group": "test",
      "problemMatcher": []
    },
    //----------------- single node single rank, OK, very fast-------------------------------------------------
    {
      "label": "Run: single node single rank",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release",
          "CASE_CONFIG": "case_study/test3/600x200_sin_1cycle_125Hz.conf",
          "METHOD_NAME": "MyStrategy2", // MyStrategy: IncrementalSVD; MyStrategy2: MyIncrementalQR1 QR online basis
          "NP": "1",
          "HOSTS": "localhost",
          "KSP_TYPE": "preonly", // preonly: direct solve; cg: iterative SPD
          "PC_TYPE": "cholesky", // cholesky for SPD dynamic elastic matrices; use lu if matrix is not SPD
          "PC_FACTOR_MAT_SOLVER_TYPE": "mkl_pardiso", // single-node direct solver; alternatives: mumps
          "POD_BACKEND": "snapshot_mkl", // snapshot_mkl: MKL POD; snapshot_eigen: Eigen POD; bdcsvd: old Eigen BDCSVD
          "ONLINE_BACKEND": "incremental_mkl", // incremental_mkl: MKL IncrementalSVD; incremental_eigen: Eigen IncrementalSVD,
          // used only by MyStrategy/IncrementalSVD; ignored by MyStrategy2
          "OMP_NUM_THREADS": "1", // try 4,8,16 for single-rank Pardiso; benchmark per machine/model
          "MKL_NUM_THREADS": "1", // match OMP_NUM_THREADS for mkl_pardiso
          "OMP_PROC_BIND": "spread", // spread or close
          "OMP_PLACES": "cores" // cores or threads
        }
      },
      "dependsOn": "CMake: build stage2 Release",
      "group": "test",
      "problemMatcher": []
    },
    //---------------------single node multi rank mumps OK very slow, sam as mkl_pardiso---------------------------------------------
    {
      "label": "Run: single node multi rank mumps",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release",
          "CASE_CONFIG": "case_study/test1/600x200_sin_1cycle_125Hz.conf",
          "METHOD_NAME": "MyStrategy", // MyStrategy: IncrementalSVD; MyStrategy2: MyIncrementalQR1 QR online basis
          "NP": "8",
          "HOSTS": "localhost",
          "KSP_TYPE": "preonly", // preonly: direct solve; cg: iterative SPD
          "PC_TYPE": "lu", // lu: general; cholesky: SPD and usually faster
          "PC_FACTOR_MAT_SOLVER_TYPE": "mumps", // mumps: MPI direct; mkl_pardiso: single-node/shared-memory direct
          "POD_BACKEND": "snapshot_mkl", // snapshot_mkl: MKL POD; snapshot_eigen: Eigen POD; bdcsvd: old Eigen BDCSVD
          "ONLINE_BACKEND": "incremental_mkl", // incremental_mkl: MKL IncrementalSVD; incremental_eigen: Eigen IncrementalSVD
          "OMP_NUM_THREADS": "1", // many MPI ranks usually use 1; hybrid test: 2,4
          "MKL_NUM_THREADS": "1", // use 1 for many MPI ranks unless testing hybrid
          "OMP_PROC_BIND": "spread", // spread or close
          "OMP_PLACES": "cores" // cores or threads
        }
      },
      "dependsOn": "CMake: build stage2 Release",
      "group": "test",
      "problemMatcher": []
    },
    //----------------------------- multi_node multi_rank mumps, slow -------------------------------------
    {
      "label": "Run: multi_node multi_rank mumps",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release",
          "CASE_CONFIG": "case_study/test1/600x200_sin_1cycle_125Hz.conf",
          "METHOD_NAME": "MyStrategy", // MyStrategy: IncrementalSVD; MyStrategy2: MyIncrementalQR1 QR online basis
          "NP": "8",
          "HOSTS": "localhost,192.168.11.21",
          "KSP_TYPE": "preonly", // preonly: direct solve; cg: iterative SPD
          "PC_TYPE": "lu", // lu: general; cholesky: SPD and can be faster if supported/stable
          "PC_FACTOR_MAT_SOLVER_TYPE": "mumps", // multinode direct solver; mkl_pardiso is not for multinode
          "POD_BACKEND": "snapshot_mkl", // snapshot_mkl: MKL POD; snapshot_eigen: Eigen POD; bdcsvd: old Eigen BDCSVD
          "ONLINE_BACKEND": "incremental_mkl", // incremental_mkl: MKL IncrementalSVD; incremental_eigen: Eigen IncrementalSVD
          "OMP_NUM_THREADS": "1", // many MPI ranks usually use 1; hybrid test: 2,4
          "MKL_NUM_THREADS": "1", // use 1 for many MPI ranks unless testing hybrid
          "OMP_PROC_BIND": "spread", // spread or close
          "OMP_PLACES": "cores" // cores or threads
        }
      },
      "dependsOn": "CMake: build stage2 Release",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Watch: main_Nam",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/watch_optimization_live.py",
        "case_study/test3",
        // Case folder to watch. Change this to case_study/test1, case_study/Debug, etc.
        "--scale",
        "8",
        // Density image scale factor. Larger value makes density pixels bigger.
        "--refresh",
        "10",
        // Live refresh interval in seconds.
        "--port",
        "8765",
        // Browser port, open http://localhost:8765.
        // "--once",
        // Run one time, save/update figures and HTML, then exit.
        // "--no-server",
        // Do not start the browser server.
        // "--no-save-figures",
        // Do not save PNG plots into case_study/<case>/figure.
        // "--figure-refresh",
        // "5.0"
        // Figure PNG export interval in seconds.
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Save figures: main_Nam once",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/watch_optimization_live.py"
        //"--once"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
