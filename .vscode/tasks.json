    //------------------multi_node multi_rank, MPI------------------------------------------------
    {
      "label": "Run: multi_node multi_rank",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/run_stage2_case.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD_DIR": "build-mpich-release-gcc13",
          // GCC11 option:
