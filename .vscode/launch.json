{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: single node single rank",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-mpich-debug/stage2_dynamic_forward",
            "args": [
                "-run_optimization",
                "1",
                "-density_plot_interval",
                "1",
                "-stage2_out",
                "case_study/Debug",
                "-fom_solver_type",
                "direct",
                "-out_dir",
                "case_study/Debug"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "value": "40000:41000",
                    "name": "MPIEXEC_PORT_RANGE"
                },
                {
                    "value": "40000:41000",
                    "name": "MPICH_PORT_RANGE"
                },
                {
                    "value": "-gl",
                    "name": "HWLOC_COMPONENTS"
                },
                {
                    "value": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps",
                    "name": "PETSC_PREFIX"
                },
                {
                    "value": "/home/votrongnam/opt/mpich-4.0-ch3-cxx",
                    "name": "MPICH_HOME"
                },
                {
                    "value": "/opt/intel/oneapi/mkl/2025.0",
                    "name": "MKLROOT"
                },
                {
                    "value": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps/lib:/home/votrongnam/opt/mpich-4.0-ch3-cxx/lib:/opt/intel/oneapi/mkl/2025.0/lib",
                    "name": "LD_LIBRARY_PATH"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build stage2 Debug"
        }
    ]
}
