{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: stage1_petsc_backend local",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-mpich-debug/stage1_petsc_backend",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "MPIEXEC_PORT_RANGE",
          "value": "45010:46000"
        },
        {
          "name": "MPICH_PORT_RANGE",
          "value": "45010:46000"
        },
        {
          "name": "HWLOC_COMPONENTS",
          "value": "-gl"
        },
        {
          "name": "PKG_CONFIG_PATH",
          "value": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx/lib/pkgconfig"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Prepare: local debug"
    }
  ]
}
