{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: single node single rank",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/votrongnam/PROJECT/Large_scale_TO/build-mpich-debug/stage2_dynamic_forward",
            "args": [
                "-run_optimization",
                "1",
                "-density_plot_interval",
                "1",
                "-stage2_out",
                "case_study/Debug/result",
                "-density_out",
                "case_study/Debug/density",
                "-fom_solver_type",
                "direct",
                "-pod_backend",
                "snapshot_mkl",
                // snapshot_mkl: MKL POD; snapshot_eigen: Eigen POD; bdcsvd: old Eigen BDCSVD
                "-online_backend",
                "incremental_mkl",
                // incremental_mkl: MKL IncrementalSVD; incremental_eigen: Eigen IncrementalSVD
                "-ksp_type",
                "preonly",
                // preonly: direct solve; cg: iterative SPD
                "-pc_type",
                "cholesky",
                // cholesky: SPD direct; lu: general direct; gamg: iterative
                "-pc_factor_mat_solver_type",
                "mkl_pardiso",
                // mkl_pardiso: single-node direct; mumps: MPI/multinode direct
                "-out_dir",
                "case_study/Debug/result"
            ],
            "stopAtEntry": false,
            "cwd": "/home/votrongnam/PROJECT/Large_scale_TO",
            "environment": [
                {
                    "value": "40000:41000",
                    "name": "MPIEXEC_PORT_RANGE"
                },
                {
                    "value": "40000:41000",
                    "name": "MPICH_PORT_RANGE"
                },
                {
                    "value": "-gl",
                    "name": "HWLOC_COMPONENTS"
                },
                {
                    "value": "/home/votrongnam/opt/petsc-3.19.6-mpich-ch3-cxx-mkl2025-mumps",
                    "name": "PETSC_PREFIX"
                },
                {
                    "value": "/home/votrongnam/opt/mpich-4.0-ch3-cxx",
